# ════════════════════════════════════════════════════════════════════════════
# FirstPass EDI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ════════════════════════════════════════════════════════════════════════════

# ── API / Authentication ─────────────────────────────────────────────────────
# Secret key for the FirstPass API (X-API-Key header)
FIRSTPASS_API_KEY=your-secret-api-key-here

# API server bind settings
FIRSTPASS_API_HOST=0.0.0.0
FIRSTPASS_API_PORT=8080

# Allowed CORS origin for the dashboard UI (optional)
# FIRSTPASS_ORIGIN=https://your-dashboard.example.com

# ── LLM Providers ───────────────────────────────────────────────────────────
# At least one LLM key is required for AI reply drafting and EDI spec parsing.
# Leave blank to run in dry-run mode (no LLM calls).

# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenAI GPT (fallback / embedding generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM model override (default: claude-3-5-sonnet-20241022)
# FIRSTPASS_LLM_MODEL=claude-3-5-sonnet-20241022

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Leave blank to run without persistence (in-memory fallback).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ── EDI Platforms ────────────────────────────────────────────────────────────
# Orderful (https://orderful.com)
ORDERFUL_API_KEY=your-orderful-api-key
ORDERFUL_BASE_URL=https://api.orderful.com/v3

# LogicBroker / CommerceHub (https://developers.logicbroker.com)
LOGICBROKER_API_KEY=your-logicbroker-subscription-key
LOGICBROKER_BASE_URL=https://commercehub.logicbroker.com/api/v1

# ── Shipping ─────────────────────────────────────────────────────────────────
# ShipStation (https://www.shipstation.com/docs/api/)
SHIPSTATION_API_KEY=your-shipstation-api-key
SHIPSTATION_API_SECRET=your-shipstation-api-secret
SHIPSTATION_BASE_URL=https://ssapi.shipstation.com

# ── ERP Integration ──────────────────────────────────────────────────────────
# Generic ERP REST adapter (Sage, SAP, NetSuite, etc.)
ERP_BASE_URL=http://your-erp-api.example.com:5000
ERP_API_KEY=your-erp-api-key
ERP_SYSTEM=Sage

# ── Inbox / Email (IMAP) ─────────────────────────────────────────────────────
# Leave blank to use demo synthetic messages.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=edi@your-company.example.com
IMAP_PASSWORD=your-imap-password

# ── Notifications ────────────────────────────────────────────────────────────
# Discord webhook for alerts and escalations (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Slack webhook (alternative to Discord)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# ── Company Identity ─────────────────────────────────────────────────────────
# Used in outbound X12 ISA headers and LLM prompts.
COMPANY_NAME=ACME Manufacturing
COMPANY_ISA_ID=ACMEMFG
COMPANY_EMAIL=edi@acme-manufacturing.example.com

# ── Agent Loop ───────────────────────────────────────────────────────────────
# How often the orchestrator polls for new work (seconds)
POLL_INTERVAL_SECONDS=60

# Max emails to process per inbox cycle
MAX_EMAILS_PER_CYCLE=50

# ── Safety / Guardrails ──────────────────────────────────────────────────────
# Orders with total value above this threshold require human approval before processing
REQUIRE_APPROVAL_ABOVE_AMOUNT=10000.00
