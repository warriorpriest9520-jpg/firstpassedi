# FirstPass EDI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o          # or gpt-4o-mini for lower cost

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" to run the full pipeline without real API calls.
# All LLM responses are replaced with realistic pre-scripted output.
# The vector store still runs locally via ChromaDB.
DEMO_MODE=true

# ── Vector store ──────────────────────────────────────────────────────────────
# Path where ChromaDB persists its data on disk.
# In production, replace chromadb with Pinecone / Weaviate and update tools/vector_store.py.
CHROMA_DB_PATH=./chroma_db

# ── ShipStation (production) ──────────────────────────────────────────────────
# In production, replace mock data in tools/shipstation_client.py with real HTTP calls.
# Docs: https://www.shipstation.com/docs/api/
SHIPSTATION_API_KEY=your-shipstation-key-here

# ── Orderful (production) ─────────────────────────────────────────────────────
# In production, replace mock responses in tools/orderful_client.py with real HTTP calls.
# Docs: https://docs.orderful.com/
ORDERFUL_API_KEY=your-orderful-key-here
ORDERFUL_ENV=sandbox           # sandbox | production
